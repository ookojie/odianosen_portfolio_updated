---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';

const description = `About ${AUTHOR_NAME} — electrical/hardware engineer.`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${AUTHOR_NAME}`} description={description} />
		<style>
			.contact-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1em;
				margin-top: 1.5em;
			}
			.contact-links a {
				text-decoration: none;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.4em 1em;
			}
			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin: 1em 0;
				padding: 0;
				list-style: none;
			}
			.skills li {
				background: rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.25em 0.9em;
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="prose">
			<h1>About Me</h1>

			<!-- TODO: replace the bio below with your real background. -->
			<p>
				I'm {AUTHOR_NAME}, an electrical/hardware engineer with experience at Microsoft (Surface
				Devices), Apple, and Kepler Communications. I work on PCB design, embedded hardware, and
				RF/antenna projects, and I run seminars at Netca on hardware design topics.
			</p>

			<h2>Current role</h2>
			<p>
				<!-- TODO: describe your current role and focus. -->
				Hardware engineer at Microsoft, Surface Devices.
			</p>

			<h2>Skills</h2>
			<ul class="skills">
				<!-- TODO: edit this list to match your actual skills. -->
				<li>PCB Design</li>
				<li>KiCad</li>
				<li>Altium</li>
				<li>Embedded Systems</li>
				<li>RF/Antenna Design</li>
				<li>NFC</li>
			</ul>

			<h2>Get in touch</h2>
			<div class="contact-links">
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href={`mailto:${SOCIAL_LINKS.email}`}>Email</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
