---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentProjects = (await getCollection('projects'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const recentWritings = (await getCollection('writings'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const recentTalks = (await getCollection('talks'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin-bottom: 3em;
			}
			.section {
				margin-bottom: 3em;
			}
			.section-header {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 1.5em;
				list-style: none;
				margin: 1em 0 0 0;
				padding: 0;
			}
			.cards a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.cards img {
				border-radius: 10px;
				margin-bottom: 0.4em;
			}
			.cards .meta {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm {AUTHOR_NAME}.</h1>
				<p>
					I'm an electrical/hardware engineer working on PCB design, embedded systems, and
					hands-on hardware projects. This site collects my projects, writings, and the
					talks and seminars I run. 
				</p>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>Recent Projects</h2>
					<a href="/projects">View all →</a>
				</div>
				{recentProjects.length === 0 && <p class="empty">No projects yet.</p>}
				<ul class="cards">
					{
						recentProjects.map((project) => (
							<li>
								<a href={`/projects/${project.id}/`}>
									<Image src={project.data.coverImage} width={400} height={225} alt="" />
									<strong>{project.data.title}</strong>
									<p class="meta">
										<FormattedDate date={project.data.date} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>Recent Writings</h2>
					<a href="/writings">View all →</a>
				</div>
				{recentWritings.length === 0 && <p class="empty">No writings yet.</p>}
				<ul class="cards">
					{
						recentWritings.map((writing) => (
							<li>
								<a href={`/writings/${writing.id}/`}>
									<strong>{writing.data.title}</strong>
									<p class="meta">
										<FormattedDate date={writing.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section">
				<div class="section-header">
					<h2>Recent Talks</h2>
					<a href="/talks">View all →</a>
				</div>
				{recentTalks.length === 0 && <p class="empty">No talks yet.</p>}
				<ul class="cards">
					{
						recentTalks.map((talk) => (
							<li>
								<a href={`/talks/${talk.id}/`}>
									<strong>{talk.data.topic}</strong>
									<p class="meta">
										{talk.data.eventName} — <FormattedDate date={talk.data.date} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
