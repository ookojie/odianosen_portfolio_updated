---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, date, tags, coverImage, galleryImages, repoUrl, status } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={coverImage} />
		<style>
			.cover-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75em;
				margin: 1em 0;
				color: rgb(var(--gray));
			}
			.status {
				display: inline-block;
				padding: 0.2em 0.7em;
				border-radius: 999px;
				font-size: 0.8em;
				font-weight: bold;
				text-transform: capitalize;
			}
			.status.ongoing {
				background: #fff3cd;
				color: #7a5b00;
			}
			.status.completed {
				background: #d4edda;
				color: #1e5b2c;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin: 1em 0;
			}
			.tag {
				background: rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.2em 0.8em;
				font-size: 0.8em;
			}
			.repo-link {
				display: inline-block;
				margin: 0.5em 0 1.5em 0;
			}
			.gallery {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1em;
				margin: 2em 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="cover-image">
					<Image src={coverImage} width={1020} height={573} alt="" />
				</div>
				<h1>{title}</h1>
				<div class="meta">
					<span class={`status ${status}`}>{status}</span>
					<FormattedDate date={date} />
				</div>
				<div class="tags">
					{tags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
				{
					repoUrl && (
						<a class="repo-link" href={repoUrl} target="_blank" rel="noopener noreferrer">
							View repository →
						</a>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{
					galleryImages && galleryImages.length > 0 && (
						<div class="gallery">
							{galleryImages.map((src) => (
								<Image src={src} width={480} height={320} alt="" />
							))}
						</div>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
